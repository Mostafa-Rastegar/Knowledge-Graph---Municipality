# Secrets — NEVER commit (contains API key + DB password)
.env

# Python
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Playwright browsers
ms-playwright/

# OS
Thumbs.db
.DS_Store

# IDE
.vscode/
.idea/

# Benchmark dataset (29MB, re-clonable from upstream) and its large derived files.
# The evaluation results stay in git: they are the evidence behind the report.
data/benchmark/*
!data/benchmark/eval_report_v*.json
!data/benchmark/eval_report_full*.json
!data/benchmark/triplets_dev_v*.jsonl

# Rendered reports (rebuild with: python -m src.md2pdf docs/FINAL_REPORT.md)
docs/*.render.html
